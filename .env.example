# Database (overridden by docker-compose*.yml — this value is for running outside Docker)
DATABASE_URL=postgresql+asyncpg://turnstile:turnstile@localhost:5432/turnstile

# Platform wallet that receives USDC payments
PLATFORM_WALLET=0xYourWalletAddressHere

# Base RPC endpoint (Alchemy or Infura)
BASE_RPC_URL=https://mainnet.base.org

# USDC contract address (Base mainnet default)
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Default price per request in USD
DEFAULT_PRICE_USD=0.01

# Chain ID returned in payment instructions (8453 = Base mainnet, 84532 = Base Sepolia)
CHAIN_ID=8453

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Postgres credentials — used only by docker-compose.yml (production-like stack)
POSTGRES_USER=turnstile
POSTGRES_PASSWORD=change-me
POSTGRES_DB=turnstile
